# Jira (single login across both instances)
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token-here

# Groq (for AI-generated release notes - free, no credit card)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Digest Email (optional - for sending the monthly digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
DIGEST_RECIPIENTS=exec-team@company.com,product@company.com
